# Python / build artifacts
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Local dev tooling installed by the M365 Agents Toolkit
devTools/
appPackage/build/

# Secrets and local environment files — provided via ACA env vars, never baked in
.env
env/.env.*.user
.localConfigs*
.notification.*store.json

# VCS / editor / docs not needed in the image
.git/
.gitignore
.vscode/
docs/
images/
*.md
!README.md

# Deployment helper script (not needed inside the container)
deploy-aca.ps1

# Local logs: setup-all.log (the tee'd 'a365 setup all' output) prints the blueprint client secret
# in cleartext - never bake it into the image.
*.log
