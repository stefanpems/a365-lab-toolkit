# ---- DW Foundry Declarative (prompt) agent — local configuration ----
# Copy to ".env" and fill in. NEVER commit the real .env (see .gitignore).

# Foundry project that hosts the declarative agent (must have a chat model deployed).
FOUNDRY_PROJECT_ENDPOINT=https://cog-xxxxxxxx.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_NAME=gpt-4.1
AGENT_NAME=agentframeworkFD-DW-agent

# Resource group that contains the Foundry resource (the Bot Service is created here).
AZURE_RESOURCE_GROUP=<your-foundry-rg>
# Azure Bot Service handle — GLOBALLY UNIQUE across ALL Azure tenants (like a DNS name).
# Leave this UNSET to use a collision-proof default `fddw-bot-<hash(rg+agent)>`. A plain name
# like "agentframeworkfd-dw-bot" fails with InvalidBotData "bot name already registered" if
# anyone else used it. Only set it for a specific 2-42 char handle.
# BOT_NAME=agentframeworkfd-dw-bot

# Publish metadata (shown in the Teams / M365 agent store).
PUBLISH_DISPLAY_NAME=AgentFramework FD Digital Worker
PUBLISH_SHORT_DESC=A Foundry declarative digital worker published to Microsoft 365.
PUBLISH_FULL_DESC=A Foundry prompt (declarative) agent published as an autopilot to Microsoft Agent 365.
PUBLISH_DEVELOPER=Agent Framework Lab
PUBLISH_APP_VERSION=1.0.0

# "Tenant" = org-wide (needs M365 admin approval); "Shared" = just you (no approval).
PUBLISH_SCOPE=Tenant
# true = publish as an Agent 365 autopilot (digital worker).
PUBLISH_AS_AUTOPILOT=true
