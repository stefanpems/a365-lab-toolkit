# ---- OBO Foundry Declarative (prompt) agent — local configuration ----
# Copy to ".env" and fill in. NEVER commit the real .env (see .gitignore).

# Foundry project that hosts the declarative agent (must have a chat model deployed).
# Format: https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://cog-xxxxxxxx.services.ai.azure.com/api/projects/<project>

# Deployed chat model name in that project.
FOUNDRY_MODEL_NAME=gpt-4.1

# Name of the declarative agent to create/update.
AGENT_NAME=agentframeworkFD-OBO-agent

# Tenant + public client used ONLY to acquire a delegated Mail token for testing.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_APP_ID=3c5eabff-e557-4da1-a216-700d0d1e5bf7

# Optional: a delegated Mail token (raw JWT or "Bearer <jwt>") for invoke_agent.py.
# Prefer generating it fresh with get_mail_token.py instead of storing it here.
# MAIL_TOKEN=
