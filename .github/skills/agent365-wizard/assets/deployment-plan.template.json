{
  "$comment": "Agent 365 deployment plan — SECRET-FREE. Generated/edited by the Lab Builder wizard. Schema: .github/skills/agent365-wizard/references/deployment-plan-schema.md",
  "version": 1,
  "solution": {
    "prefix": "<SOLUTION_PREFIX>",
    "tenantId": "<TENANT_ID>",
    "subscriptionId": "<SUBSCRIPTION_ID>",
    "region": "<AZURE_REGION>",
    "secretHandling": "manual",
    "resourceGroupStrategy": "isolated",
    "sharedResourceGroup": "<SOLUTION_PREFIX>-rg",
    "$comment_foundry": "OPTIONAL — only if the lab has FH/FD agents. All FH+FD agents share this ONE Foundry footprint. mode 'create-shared' = the wizard provisions one account+project '<SOLUTION_PREFIX>'+model in <SOLUTION_PREFIX>-foundry-rg; mode 'reuse-existing' = deploy into an existing project (set endpoint/account/existingResourceGroup, no provision — the resilient path if new-account hosted-agent provisioning is degraded). Remove this block for the legacy per-agent-account behaviour. FH-DW always keeps its own account.",
    "foundry": {
      "mode": "create-shared",
      "resourceGroup": "<SOLUTION_PREFIX>-foundry-rg",
      "project": "<SOLUTION_PREFIX>",
      "deployment": "gpt-4.1",
      "modelVersion": "2025-04-14",
      "endpoint": "",
      "account": "",
      "existingResourceGroup": ""
    }
  },
  "agents": [
    {
      "type": "ACA-OBO",
      "name": "<SOLUTION_PREFIX>-ACA-OBO",
      "displayNames": {
        "blueprint": "<SOLUTION_PREFIX>-ACA-OBO Blueprint",
        "identity": "<SOLUTION_PREFIX>-ACA-OBO Identity"
      },
      "resourceGroup": "<SOLUTION_PREFIX>-ACA-OBO-rg",
      "ai": { "kind": "azure-openai", "account": "<AOAI_ACCOUNT>", "deployment": "gpt-4.1", "auth": "managed-identity" },
      "tools": ["mcp_MailTools"]
    }
  ],
  "ui": {
    "mode": "none",
    "name": "<SOLUTION_PREFIX>-ui",
    "hosting": "static-web-app",
    "swaRegion": "<AZURE_REGION>",
    "existing": { "spaAppId": "", "origin": "", "staticWebApp": "" },
    "expose": [],
    "permissions": { "mailConsent": false, "s2sAudience": false, "foundryAccess": [] }
  },
  "customMcp": {
    "enabled": false,
    "publisher": "<PUBLISHER>",
    "servers": ["anon", "auth"],
    "resourceGroup": "<SOLUTION_PREFIX>-mcp-rg",
    "region": "<AZURE_REGION>",
    "attachTo": [],
    "integrationMode": "approve-first",
    "propagateToGraph": false
  }
}
