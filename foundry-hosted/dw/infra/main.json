    {
      "condition": "[variables('createBlueprintViaScript')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "maib-creation-script",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "uamiResourceId": {
            "value": "[reference(resourceId('Microsoft.Resources/deployments', 'deployment-script-umi'), '2025-04-01').outputs.uamiResourceId.value]"
          },
          "azureAIProjectEndpoint": {
            "value": "[reference(resourceId('Microsoft.Resources/deployments', 'project-deployment'), '2025-04-01').outputs.foundryProjectEndpoint.value]"
          },
          "maibName": {
            "value": "[parameters('maibName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.45.15.27210",
              "templateHash": "10302630236864760326"
            }
          },
          "parameters": {
            "uamiResourceId": {
              "type": "string",
              "metadata": {
                "description": "User-assigned managed identity resource ID that the script will run as"
              }
            },
            "azureAIProjectEndpoint": {
              "type": "string",
              "metadata": {
                "description": "Azure AI Project Endpoint URL"
              }
            },
            "maibName": {
              "type": "string",
              "metadata": {
                "description": "Managed agent identity blueprint name for the Azure AI Project"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Resources/deploymentScripts",
              "apiVersion": "2023-08-01",
              "name": "create-agent-script",
              "location": "[resourceGroup().location]",
              "kind": "AzurePowerShell",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', parameters('uamiResourceId'))]": {}
                }
              },
              "properties": {
                "azPowerShellVersion": "11.5",
                "timeout": "PT15M",
                "retentionInterval": "P1D",
                "arguments": "[format('-AzureAIProjectEndpoint \"{0}\" -MAIBName \"{1}\"', parameters('azureAIProjectEndpoint'), parameters('maibName'))]",
                "environmentVariables": [
                  {
                    "name": "RESOURCE_GROUP_NAME",
                    "value": "[resourceGroup().name]"
                  }
                ],
                "scriptContent": "  param(\r\n    [Parameter(Mandatory = $true)]\r\n    [string] $AzureAIProjectEndpoint,\r\n    [Parameter(Mandatory = $true)]\r\n    [string] $MAIBName\r\n  )\r\n\r\n  $ErrorActionPreference = \"Stop\"\r\n\r\n  $maibUrl = \"$($AzureAIProjectEndpoint)/managedagentidentityblueprints/$($MAIBName)?api-version=2025-11-15-preview\"\r\n\r\n  Write-Host \"Connecting with managed identity...\"\r\n  Connect-AzAccount -Identity\r\n\r\n  Write-Host \"Getting access token for https://ai.azure.com ...\"\r\n  $tokenResponse = Get-AzAccessToken -ResourceUrl \"https://ai.azure.com\"\r\n  $aiAzureToken  = $tokenResponse.Token | ConvertFrom-SecureString -AsPlainText\r\n  Write-Host \"Token length: $($aiAzureToken.Length)\"\r\n\r\n  $headers = @{\r\n      \"Content-Type\"  = \"application/json\"\r\n      \"Accept\"        = \"application/json\"\r\n      \"Authorization\" = \"Bearer $aiAzureToken\"\r\n  }\r\n\r\n  Write-Host \"Creating managed agent identity blueprint at: $maibUrl\"\r\n    \r\n  $response = Invoke-RestMethod -Uri $maibUrl `\r\n      -Method Put `\r\n      -Headers $headers `\r\n      -ErrorAction Stop\r\n\r\n  Write-Host \"\"\r\n  Write-Host \"Response:\"\r\n  $response | ConvertTo-Json -Depth 100 | Write-Host\r\n  \r\n  $blueprintClientId = $response.agentIdentityBlueprint.clientId\r\n\r\n  $DeploymentScriptOutputs = @{\r\n      blueprintClientId = $blueprintClientId\r\n  }\r\n\r\n"
              }
            }
          ],
          "outputs": {
            "blueprintClientId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Resources/deploymentScripts', 'create-agent-script'), '2023-08-01').outputs.blueprintClientId]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'deployment-script-umi')]",
        "[resourceId('Microsoft.Resources/deployments', 'project-deployment')]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
