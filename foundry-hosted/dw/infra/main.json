      "type": "string",
      "defaultValue": "S0",
      "metadata": {
        "description": "SKU of Cognitive Services account"
      }
    },
    "containerRegistrySku": {
      "type": "string",
      "defaultValue": "Basic",
      "allowedValues": [
        "Basic",
        "Standard",
        "Premium"
      ],
      "metadata": {
        "description": "SKU of Container Registry"
      }
    },
    "agentName": {
      "type": "string",
      "defaultValue": "agentframeworkFH-DW2-agent"
    },
    "maibName": {
      "type": "string",
      "defaultValue": "[format('{0}-maib', parameters('agentName'))]"
    },
    "botName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Name (handle) of the Bot Service. Bot handles are GLOBALLY unique across all\nAzure tenants, so the default appends a resource-group hash to avoid collisions with other\ndeployments of this sample (e.g. the reference lab). Override via azd var AGENT_BOT_NAME."
      }
    },
    "botDisplayName": {
      "type": "string",
      "defaultValue": "[format('{0} Bot', parameters('agentName'))]",
      "metadata": {
        "description": "Display name of the bot"
      }
    },
