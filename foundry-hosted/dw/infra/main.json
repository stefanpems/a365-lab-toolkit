          "endpoint": {
            "value": "[format('https://{0}.services.ai.azure.com/api/projects/{1}/agents/{2}/endpoint/protocols/activityProtocol?api-version=2025-05-15-preview', parameters('accountName'), parameters('projectName'), parameters('agentName'))]"
          },
          "botServiceSku": {
            "value": "[parameters('botServiceSku')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
