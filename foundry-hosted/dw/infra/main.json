      "type": "string",
      "defaultValue": "F0",
      "metadata": {
        "description": "SKU of the Bot Service"
      }
    },
    "modelName": {
      "type": "string",
      "defaultValue": "gpt-4.1",
      "metadata": {
        "description": "Model name"
      }
    },
    "modelVersion": {
      "type": "string",
      "defaultValue": "2025-04-14",
      "metadata": {
        "description": "Model version"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags to apply to all resources"
      }
    },
    "agentIdentityBlueprintClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Client id of a pre-created managed agent identity blueprint. When set, the ARM\ndeployment script that creates the blueprint is SKIPPED. Required on subscriptions whose policy\nforbids shared-key access on storage accounts, because ARM deploymentScripts mount their file\nshare with the storage shared key and fail with KeyBasedAuthenticationNotPermitted. Create the\nblueprint out-of-band (PUT {projectEndpoint}/managedagentidentityblueprints/{maibName}) and pass\nits agentIdentityBlueprint.clientId here."
      }
    }
  },
  "variables": {
    "effectiveBotName": "[if(empty(parameters('botName')), format('fhdw-bot-{0}', uniqueString(resourceGroup().id)), parameters('botName'))]",
    "createBlueprintViaScript": "[empty(parameters('agentIdentityBlueprintClientId'))]"
